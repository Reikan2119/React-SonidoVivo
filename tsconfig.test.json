{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["ES2020", "DOM"],
    "types": ["jasmine"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./karma-dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/karma/**/*.ts", "src/utils/**/*.ts"]
}